<?xml version="1.0" encoding="utf-8"?>
<!-- Leaf app icon (original artwork). Adaptive-icon foreground: 108x108. The diagonal leaf is
     scaled to stay inside the safe zone (r=33), which launcher masks and the splash screen show. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateX="0"
        android:translateY="-0.4">
    <!-- soft shadow -->
    <path
        android:fillColor="#26000000"
        android:pathData="M39,78 C24,62 34,34 80,29 C84,55 66,80 39,78 Z" />
    <!-- leaf body -->
    <path
        android:fillColor="#5DB24A"
        android:pathData="M37,75 C22,59 32,31 78,26 C82,52 64,77 37,75 Z" />
    <!-- lit half -->
    <path
        android:fillColor="#7FCB5E"
        android:pathData="M37,75 C22,59 32,31 78,26 C62,40 48,56 37,75 Z" />
    <!-- highlight -->
    <path
        android:fillColor="#B4E58F"
        android:pathData="M36,62 C33,48 44,36 62,32 C50,39 42,49 36,62 Z" />
    <!-- main vein -->
    <path
        android:pathData="M37,75 C50,60 62,44 76,28"
        android:strokeColor="#3E8A34"
        android:strokeLineCap="round"
        android:strokeWidth="2.6" />
    <!-- side veins -->
    <path
        android:pathData="M46,64 L58,64 M54,54 L66,54 M62,45 L71,45 M45,64 L44,52 M53,54 L53,43 M61,45 L62,36"
        android:strokeColor="#3E8A34"
        android:strokeAlpha="0.75"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
    <!-- stem with a little curl -->
    <path
        android:pathData="M38,74 C35,78 32,81 28,83"
        android:strokeColor="#3E8A34"
        android:strokeLineCap="round"
        android:strokeWidth="3.4" />
    </group>
</vector>
